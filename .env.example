# ==============================================================================
# SchemeSaathi Environment Variables Example
# Duplicate this file to .env.local and fill in your real values.
# DO NOT commit real secrets or API keys to version control.
# ==============================================================================

# Google Gemini API Key (for AI Assistant, Natural Language intent parser, and Scheme Explainers)
# Get a free key at: https://aistudio.google.com/app/apikey
# NOTE: App runs in graceful fallback mode if not provided.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Production Authentication & PostgreSQL Database)
# Found in your Supabase Project Settings -> API: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Session encryption secret (fallback defaults to built-in development key)
SESSION_SECRET=your_secure_random_session_secret_key_here
